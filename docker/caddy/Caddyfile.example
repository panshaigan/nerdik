# Reference only — production Caddy config is generated at container start by
# docker/caddy/entrypoint.sh from APP_DOMAIN, STAGING_DOMAIN, STAGING_MAILPIT_DOMAIN,
# and ACME_EMAIL in .env.
#
# Upstreams use fixed Docker container names (not service names) so prod and staging
# cannot collide on the shared nerdik-edge network.

{
	email you@example.com
}

nerdik.app {
	encode gzip

	# root / is required so the absolute flag path is not joined to a site root.
	@maintenance file /etc/caddy/state/maintenance {
		root /
	}

	handle @maintenance {
		error 503
	}

	handle /app/* {
		reverse_proxy nerdik-prod-reverb:8080
	}

	handle {
		reverse_proxy nerdik-prod-app:80 {
			transport http {
				read_timeout 30s
				dial_timeout 5s
			}
		}
	}

	# Flag mode (error 503) and upstream 502–504 share this page.
	handle_errors {
		@upstream expression {http.error.status_code} >= 502 && {http.error.status_code} <= 504
		handle @upstream {
			root * /etc/caddy/maintenance
			rewrite * /index.html
			header Cache-Control "no-store"
			header Retry-After "300"
			header Refresh "15"
			file_server {
				status 503
			}
		}
	}
}

staging.nerdik.app {
	encode gzip

	handle /app/* {
		reverse_proxy nerdik-staging-reverb:8080 {
			transport http {
				read_timeout 5s
				dial_timeout 2s
			}
		}
	}

	handle {
		reverse_proxy nerdik-staging-app:80 {
			transport http {
				read_timeout 5s
				dial_timeout 2s
			}
		}
	}

	handle_errors {
		respond "Staging is offline" 503
	}
}

mail.staging.nerdik.app {
	encode gzip

	reverse_proxy nerdik-staging-mailpit:8025 {
		transport http {
			read_timeout 30s
			dial_timeout 5s
		}
	}
}
